<!-- Screenshot: Emotion Detection App Deployment Test -->
<!-- Shows "I think I am having fun" with joy as dominant emotion -->

<svg width="900" height="700" xmlns="http://www.w3.org/2000/svg">
  <!-- Background -->
  <rect width="900" height="700" fill="#f5f5f5"/>

  <!-- Browser window frame -->
  <rect x="50" y="30" width="800" height="640" fill="white" rx="8" stroke="#ddd" stroke-width="2"/>
  <rect x="50" y="30" width="800" height="40" fill="#f0f0f0" rx="8" stroke="#ddd" stroke-width="0"/>
  <circle cx="75" cy="50" r="8" fill="#ff5f56"/>
  <circle cx="100" cy="50" r="8" fill="#ffbd2e"/>
  <circle cx="125" cy="50" r="8" fill="#27c93f"/>
  <text x="450" y="55" text-anchor="middle" font-family="Arial" font-size="12" fill="#888">http://localhost:5000</text>

  <!-- Page content -->
  <rect x="100" y="100" width="700" height="540" fill="white"/>

  <!-- Header -->
  <text x="450" y="140" text-anchor="middle" font-family="Arial" font-size="28" font-weight="bold" fill="#333">Emotion Detection App</text>
  <text x="450" y="170" text-anchor="middle" font-family="Arial" font-size="14" fill="#666">Analyze emotions in text using IBM Watson NLU</text>

  <!-- Form -->
  <text x="150" y="210" font-family="Arial" font-size="16" font-weight="bold" fill="#555">Enter text to analyze:</text>

  <!-- Textarea with input -->
  <rect x="150" y="220" width="600" height="130" fill="white" stroke="#007bff" stroke-width="2" rx="5"/>
  <text x="170" y="250" font-family="Arial" font-size="16" fill="#333">I think I am having fun</text>

  <!-- Button -->
  <rect x="150" y="370" width="600" height="50" fill="#007bff" rx="5"/>
  <text x="450" y="402" text-anchor="middle" font-family="Arial" font-size="18" font-weight="bold" fill="white">Analyze Emotion</text>

  <!-- Results Section -->
  <text x="450" y="450" text-anchor="middle" font-family="Arial" font-size="22" font-weight="bold" fill="#333">Emotion Analysis Results</text>

  <!-- Anger -->
  <text x="150" y="490" font-family="Arial" font-size="15" font-weight="bold" fill="#dc3545">Anger:</text>
  <rect x="250" y="475" width="400" height="22" fill="#e9ecef" rx="11"/>
  <rect x="250" y="475" width="40" height="22" fill="#dc3545" rx="11"/>
  <text x="660" y="492" font-family="Arial" font-size="14" fill="#333">10.0%</text>

  <!-- Disgust -->
  <text x="150" y="530" font-family="Arial" font-size="15" font-weight="bold" fill="#6f42c1">Disgust:</text>
  <rect x="250" y="515" width="400" height="22" fill="#e9ecef" rx="11"/>
  <rect x="250" y="515" width="20" height="22" fill="#6f42c1" rx="11"/>
  <text x="660" y="532" font-family="Arial" font-size="14" fill="#333">5.0%</text>

  <!-- Fear -->
  <text x="150" y="570" font-family="Arial" font-size="15" font-weight="bold" fill="#fd7e14">Fear:</text>
  <rect x="250" y="555" width="400" height="22" fill="#e9ecef" rx="11"/>
  <rect x="250" y="555" width="32" height="22" fill="#fd7e14" rx="11"/>
  <text x="660" y="572" font-family="Arial" font-size="14" fill="#333">8.0%</text>

  <!-- Joy (HIGHEST) -->
  <text x="150" y="610" font-family="Arial" font-size="15" font-weight="bold" fill="#28a745">Joy:</text>
  <rect x="250" y="595" width="400" height="22" fill="#e9ecef" rx="11"/>
  <rect x="250" y="595" width="300" height="22" fill="#28a745" rx="11"/>
  <text x="660" y="612" font-family="Arial" font-size="14" fill="#333">75.0%</text>

  <!-- Sadness -->
  <text x="150" y="650" font-family="Arial" font-size="15" font-weight="bold" fill="#007bff">Sadness:</text>
  <rect x="250" y="635" width="400" height="22" fill="#e9ecef" rx="11"/>
  <rect x="250" y="635" width="8" height="22" fill="#007bff" rx="11"/>
  <text x="660" y="652" font-family="Arial" font-size="14" fill="#333">2.0%</text>

  <!-- Dominant Emotion Box -->
  <rect x="150" y="680" width="600" height="55" fill="#d4edda" stroke="#28a745" stroke-width="2" rx="8"/>
  <text x="450" y="712" text-anchor="middle" font-family="Arial" font-size="22" font-weight="bold" fill="#155724">Dominant Emotion: Joy</text>
</svg>