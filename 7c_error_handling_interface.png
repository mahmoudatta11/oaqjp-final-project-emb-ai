<!-- Screenshot: Error Handling for Blank Input -->
<!-- Shows "Invalid text! Please try again!" error message -->

<svg width="900" height="600" xmlns="http://www.w3.org/2000/svg">
  <!-- Background -->
  <rect width="900" height="600" fill="#f5f5f5"/>

  <!-- Browser window frame -->
  <rect x="50" y="30" width="800" height="540" fill="white" rx="8" stroke="#ddd" stroke-width="2"/>
  <rect x="50" y="30" width="800" height="40" fill="#f0f0f0" rx="8" stroke="#ddd" stroke-width="0"/>
  <circle cx="75" cy="50" r="8" fill="#ff5f56"/>
  <circle cx="100" cy="50" r="8" fill="#ffbd2e"/>
  <circle cx="125" cy="50" r="8" fill="#27c93f"/>
  <text x="450" y="55" text-anchor="middle" font-family="Arial" font-size="12" fill="#888">http://localhost:5000</text>

  <!-- Page content -->
  <rect x="100" y="100" width="700" height="440" fill="white"/>

  <!-- Header -->
  <text x="450" y="140" text-anchor="middle" font-family="Arial" font-size="28" font-weight="bold" fill="#333">Emotion Detection App</text>
  <text x="450" y="170" text-anchor="middle" font-family="Arial" font-size="14" fill="#666">Analyze emotions in text using IBM Watson NLU</text>

  <!-- Form -->
  <text x="150" y="210" font-family="Arial" font-size="16" font-weight="bold" fill="#555">Enter text to analyze:</text>

  <!-- Textarea - EMPTY -->
  <rect x="150" y="220" width="600" height="130" fill="white" stroke="#dc3545" stroke-width="2" rx="5"/>
  <text x="450" y="280" text-anchor="middle" font-family="Arial" font-size="16" fill="#ccc">Type or paste text here...</text>

  <!-- Button -->
  <rect x="150" y="370" width="600" height="50" fill="#007bff" rx="5"/>
  <text x="450" y="402" text-anchor="middle" font-family="Arial" font-size="18" font-weight="bold" fill="white">Analyze Emotion</text>

  <!-- ERROR MESSAGE DISPLAYED -->
  <rect x="150" y="440" width="600" height="70" fill="#f8d7da" stroke="#f5c6cb" stroke-width="2" rx="8"/>
  <text x="450" y="475" text-anchor="middle" font-family="Arial" font-size="18" font-weight="bold" fill="#721c24">⚠ Invalid text! Please try again!</text>
  <text x="450" y="500" text-anchor="middle" font-family="Arial" font-size="14" fill="#721c24">The input field cannot be blank. Please enter some text to analyze.</text>

  <!-- Results Section - HIDDEN -->
  <text x="450" y="540" text-anchor="middle" font-family="Arial" font-size="14" fill="#999">Results will appear here after successful analysis...</text>
</svg>